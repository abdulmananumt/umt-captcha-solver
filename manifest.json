{
  "manifest_version": 3,
  "name": "UMT CAPTCHA Auto-Fill",
  "version": "1.0",
  "description": "Automatically detects and fills the CAPTCHA on online.umt.edu.pk login page.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://online.umt.edu.pk/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://online.umt.edu.pk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
